# ─── WHO BETTER!? env ─────────────────────────────────────────────────────
# Neon Postgres connection string (pooled). Create a NEW Neon project named
# "whobetter" (free tier, AWS US East 2 Ohio like the ratio-poll project),
# then paste the pooled connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/whobetter?sslmode=require"

# Salt for IP hashing (rate limiting). Any long random string.
IP_SALT="change-me-to-a-long-random-string"

# Public site URL — used for link previews (og:image). Set to the real
# deployed URL in Vercel, e.g. https://whobetter.vercel.app
NEXT_PUBLIC_SITE_URL="https://whobetter.vercel.app"
